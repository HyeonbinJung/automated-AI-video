# Copy this file to .env. Keys stay on the server; never put them in VITE_* vars.
PORT=8787
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
GEMINI_API_KEY=
IMAGE_MODEL=gemini-3.1-flash-image-preview
# Provider calls are paid. Each generation requires a UI button click.
# IMPORTANT: Do not expose this local development server to the public internet without auth.

# Seedance 1.5 Pro video (cheapest image-to-video, 480p) through Kie AI: https://kie.ai/api-key
KIE_API_KEY=
# Billing: every AI call is deducted at provider cost + MARKUP (min 0.2); see apps/server/pricing.js
# KRW_PER_USD=1400
# MARKUP=0.2
# Set to 0 once a payment gateway credits the wallet (disables the test top-up buttons)
# WALLET_DEV_TOPUP=1
